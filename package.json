  "bugs": {
    "url": "https://github.com/lumine-code/theme-selector/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "aura-theme",
    "nova-theme",
    "vscode-theme"
  ],
  "scripts": {
